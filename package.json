{
  "name": "tokobaju-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "migrate": "cd services/api && pnpm prisma migrate dev",
    "docker:dev": "docker compose -f infra/docker/docker-compose.yml up --build"
  },
  "devDependencies": {
    "turbo": "^1.11.0",
    "typescript": "^5.5.0",
    "prettier": "^3.0.0"
  }
}
